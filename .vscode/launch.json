    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "UnioneGateway",
            "request": "launch",
            "mainClass": "com.unione.cloud.gateway.Application",
            "projectName": "unione-gateway",
            "vmArgs": "-Dfile.encoding=UTF-8 -Dserver.port=8090 -Dspring.cloud.nacos.config.enabled=true -Dspring.cloud.nacos.config.server-addr=127.0.0.1:8848"
        },
        {
            "type": "java",
            "name": "UnioneJobApplication",
            "request": "launch",
            "mainClass": "com.unione.cloud.job.UnioneJobApplication",
            "projectName": "unione-job",
            "vmArgs": "-Dfile.encoding=UTF-8 -Dserver.port=8081"
        },
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}",
            "vmArgs": "-Dfile.encoding=UTF-8"
        },
        {
            "type": "java",
            "name": "UnioneStarter",
            "request": "launch",
            "mainClass": "com.unione.cloud.Application",
            "projectName": "unione-starter",
            "vmArgs": "-Dfile.encoding=UTF-8 -Dspring.cloud.nacos.config.enabled=true -Dspring.cloud.nacos.config.server-addr=127.0.0.1:8848"
        }
    ]
}