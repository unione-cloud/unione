whereCondition
===
```
<%
for(col in cols){
  var colName=col;
  var attr = @nc.getPropertyName(col);
%>
${SS}if(!isEmpty(params.${attr})){${SE}
  AND ${colName}=${PS}params.${attr}${PE}
${SS}}${SE}
<%}%>

*关键字搜索，自行根据需要开启
*${SS}if(!isEmpty(query.keywords)){${SE}
* AND (FIELD1 LIKE ${PS}'%'+query.keywords+'%'${PE} OR FIELD2 LIKE ${PS}'%'+query.keywords+'%'${PE})
*${SS}}${SE}
```


byIdCondition
===
```
${SS}if(isEmpty(query.id) && isEmpty(query.ids)){
  AND 1=2
${SS}}
${SS}if(isNotEmpty(query.id)){
  AND ${idAttr.colName} = query.id;
${SS}}
${SS}if(isNotEmpty(query.ids)){
  AND ${idAttr.colName} IN ( ${PS}join(query.ids)${PE} )
${SS}}
${SS}if(isNotEmpty(params.${tenantId.name})){
  AND ${tenantId.column} = params.${tenantId.name}
${SS}}
${SS}if(isNotEmpty(params.${orgId.name})){
  AND ${orgId.column} = params.${orgId.name}
${SS}}
```


update
===
```sql
UPDATE ${tableName} SET ${PS}use("updateCloume")${PE} WHERE 1=1 ${PS}use("whereCondition")${PE}
```

updateById
===
```sql
UPDATE ${tableName} SET ${PS}use("updateCloume")${PE} WHERE 1=1 ${PS}use("byIdCondition")${PE}
```

delete
===
```sql
DELETE FROM ${tableName} WHERE 1=1 ${PS}use("whereCondition")${PE}
```

deleteById
===
```sql
DELETE FROM ${tableName} WHERE 1=1 ${PS}use("byIdCondition")${PE}
```

deleteLogic
===
```sql
UPDATE ${tableName}
SET ${delFlag.column}=1,${lastUpdate.column} = ${PS}params.${lastUpdate.name}${PE},${lastUpdateBy.column} = ${PS}params.${lastUpdateBy.name}${PE}
WHERE 1=1 ${PS}use("whereCondition")${PE}
```

deleteLogicById
===
```sql
UPDATE ${tableName}
SET ${delFlag.column}=1,${lastUpdate.column} = ${PS}params.${lastUpdate.name}${PE},${lastUpdateBy.column} = ${PS}params.${lastUpdateBy.name}${PE}
WHERE 1=1 ${PS}use("byIdCondition")${PE}
```


count
===
```sql
SELECT COUNT(*) FROM ${tableName} WHERE 1=1 ${PS}use("whereCondition")${PE}
```

